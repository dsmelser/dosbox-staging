
#include "winresrc.h"
#include "@CMAKE_CURRENT_SOURCE_DIR@/resource.h"

// icon resource
IDI_LAUNCHER ICON "@CMAKE_SOURCE_DIR@/extras/icons/windows/dosbox-staging.ico"

// version resource
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @CMAKE_PROJECT_VERSION_MAJOR@,@CMAKE_PROJECT_VERSION_MINOR@,@CMAKE_PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @CMAKE_PROJECT_VERSION_MAJOR@,@CMAKE_PROJECT_VERSION_MINOR@,@CMAKE_PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "(C) 2026 The DOSBox Staging Team, published under GNU GPL"
            VALUE "CompanyName", "DOSBox Staging"
            VALUE "FileDescription", "DOSBox Staging Launcher"
            VALUE "FileVersion", "@CMAKE_PROJECT_VERSION_MAJOR@, @CMAKE_PROJECT_VERSION_MINOR@, @CMAKE_PROJECT_VERSION_PATCH@, 0"
            VALUE "InternalName", "dosbox-staging-launcher"
            VALUE "LegalCopyright", "Copyright (C) 2026 The DOSBox Staging Team"
            VALUE "OriginalFilename", "dosbox_launcher.exe"
            VALUE "ProductName", "DOSBox Staging"
            VALUE "ProductVersion", "@CMAKE_PROJECT_VERSION_MAJOR@, @CMAKE_PROJECT_VERSION_MINOR@, @CMAKE_PROJECT_VERSION_PATCH@, 0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_LAUNCHER DIALOGEX 0, 0, 440, 332
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Run with DOSBox Staging"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Item:", -1, 7, 9, 40, 8
    EDITTEXT        IDC_ITEM_PATH, 50, 7, 383, 12, ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    LTEXT           "Config files:", -1, 7, 25, 40, 8
    EDITTEXT        IDC_CONFIG_FILES, 50, 23, 383, 12, ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    CONTROL         "", IDC_TABS, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS, 7, 41, 426, 200
    LTEXT           "", IDC_NOTE, 7, 245, 426, 8
    CONTROL         "&Exit DOSBox when the program ends", IDC_EXIT_AFTER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 257, 200, 10
    CONTROL         "&Mount the folder as drive C:", IDC_MOUNT_FOLDER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 257, 200, 10
    CONTROL         "Show the &log console", IDC_SHOW_CONSOLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 220, 257, 150, 10
    LTEXT           "Command line:", -1, 7, 271, 100, 8
    EDITTEXT        IDC_COMMAND_LINE, 7, 281, 380, 24, ES_MULTILINE | ES_READONLY | WS_VSCROLL | NOT WS_TABSTOP
    CONTROL         "&Copy", IDC_COPY, "Button", BS_SPLITBUTTON | WS_TABSTOP, 391, 281, 42, 14
    PUSHBUTTON      "Reset &all", IDC_RESET_ALL, 7, 311, 60, 14
    DEFPUSHBUTTON   "&Run", IDOK, 317, 311, 55, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 378, 311, 55, 14
END

IDD_COMMON_PAGE DIALOGEX 0, 0, 418, 180
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_COMMON_HELP, 4, 144, 410, 34, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_TABSTOP
END

IDD_ALL_SETTINGS_PAGE DIALOGEX 0, 0, 418, 180
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_FILTER, 4, 4, 160, 12, ES_AUTOHSCROLL
    CONTROL         "", IDC_SETTINGS_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 4, 20, 410, 98
    LTEXT           "", IDC_SETTING_NAME, 4, 124, 150, 8
    COMBOBOX        IDC_VALUE_LIST, 158, 122, 190, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_VALUE_EDIT, 158, 122, 190, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "R&eset", IDC_RESET_SETTING, 354, 121, 60, 14
    EDITTEXT        IDC_SETTING_HELP, 4, 140, 410, 38, ES_MULTILINE | ES_READONLY | WS_VSCROLL | WS_TABSTOP
END
